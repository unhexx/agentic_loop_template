{
  "question_pool": {
    "frequency": "every_3_cycles",
    "N": 3,
    "processors": [
      "product_owner",
      "project_manager"
    ],
    "last_processed_cycle": 0
  },
  "meta_optimizer": {
    "enabled": true,
    "frequency": "after_every_done_cycle",
    "min_quality": {
      "confidence": 0.85,
      "tests_failed": 0,
      "process_violations": 0
    },
    "auto_apply_safe": false,
    "auto_harvest_on_done": false,
    "max_proposals_per_cycle": 3,
    "last_harvested_cycle": 0
  },
  "daily_decomposition_ritual": {
    "enabled": true,
    "frequency": "every_10_cycles",
    "N": 10,
    "last_ritual_cycle": 0
  },
  "model_routing": {
    "enabled": true,
    "strategy": "role_based",
    "frontend": "antigravity",
    "roles": {
      "Orchestrator": { "provider": "anthropic", "model": "claude-opus-4-6", "thinking": "adaptive", "temperature": 0.0 },
      "Coder": { "provider": "anthropic", "model": "claude-sonnet-4-6", "thinking": "adaptive", "temperature": 0.2 },
      "Tester": { "provider": "anthropic", "model": "claude-sonnet-4-6", "thinking": "adaptive", "temperature": 0.0 },
      "Debugger": { "provider": "anthropic", "model": "claude-sonnet-4-6", "thinking": "adaptive", "temperature": 0.2 },
      "Reviewer": { "provider": "anthropic", "model": "claude-opus-4-6", "thinking": "adaptive", "temperature": 0.0 }
    },
    "fallbacks": {
      "Coder": { "provider": "google", "model": "gemini-3.7-flash", "allowed_when": "mechanical_or_scaffolding_only" }
    },
    "escalation": {
      "Debugger": { "after_failed_rounds": 2, "provider": "anthropic", "model": "claude-opus-4-6", "reason": "same_root_cause_unresolved" }
    },
    "availability_policy": "verify_model_in_frontend_before_start",
    "last_verified": "2026-09-25"
  },
  "playbooks": {
    "enabled": true,
    "auto_curate": false,
    "max_bullets_per_playbook": 50,
    "default_k": 5,
    "min_effectiveness": 0.5,
    "relevance": "substring",
    "scopes": ["global", "role:*", "tool:*", "phase:*"]
  },
  "git": {
    "strict_multi_repo": false,
    "prefer_preflight_script": true
  },
  "context_budget": {
    "cold_start_tokens": 16000,
    "next_input_files_tokens": 12000,
    "compress_when_over": true,
    "encoding": null,
    "model": null,
    "prompt_body_chars": 8000,
    "snap_json_chars": 4000,
    "knowledge_budget_tokens": 800,
    "prompt_token_cap": 8000
  },
  "state": {
    "max_working_json_bytes": 8192,
    "auto_compact_on_init": true
  },
  "profiles": {
    "single_repo_linux": {
      "git": {
        "strict_multi_repo": false
      }
    },
    "multi_repo_windows": {
      "git": {
        "strict_multi_repo": true
      }
    },
    "grok_parallel": {
      "git": {
        "strict_multi_repo": false
      },
      "parallel": true
    }
  },
  "proxy": {
    "mode": "required",
    "listen": "127.0.0.1:8110",
    "pxpipe_base": "http://127.0.0.1:8100",
    "upstream_fallback": "https://cli-chat-proxy.grok.com",
    "bind": "loopback",
    "timeout_s": 900,
    "compress_body": true,
    "body_budget_tokens": 24000,
    "keep_recent_turns": 2,
    "exact_cache": true,
    "fidelity": true,
    "plugins": {
      "llmlingua": false,
      "sqlite_vec": false
    }
  },
  "supervisor": {
    "adapter": "mock",
    "adapters_by_role": {
      "Orchestrator": "mock",
      "Coder": "mock",
      "Tester": "mock",
      "Debugger": "mock",
      "Reviewer": "mock"
    },
    "stack_check_on_start": false,
    "max_cycles": 5,
    "max_role_retries": 2,
    "role_timeout_s": 900,
    "pr": {
      "base": "main",
      "draft": false,
      "title_prefix": "agentix:"
    },
    "adapters": {
      "grok": {
        "command": "grok"
      },
      "cursor": {
        "command": null
      }
    },
    "block_process_tags": [
      "secrets_exposure",
      "destructive_prod"
    ],
    "parallel": {
      "base": "main",
      "integration_branch": "feature/integration-parallel",
      "wt_base": null,
      "require_owned_paths": true,
      "serial": true,
      "concurrent": false,
      "push": false,
      "lease_ttl_s": 7200
    }
  },
  "_local_pipeline_comment": "act is the default for a free-plan solo maintainer; set backend to jenkins only when the org mandates Bitbucket Server/Data Center and Jenkins; set backend to self_hosted only after a human has registered a runner; do not put tokens in this file",
  "local_pipeline": {
    "enabled": false,
    "backend": "act",
    "notify": false,
    "act": {
      "workflow_file": ".github/workflows/agentix-loop.yml",
      "job_name": "harness",
      "runner_image": "catthehacker/ubuntu:act-22.04",
      "secret_file": ".secrets",
      "pull": false,
      "cache_server": false,
      "bind_workdir": false,
      "mount_docker_sock": false,
      "acknowledge_dind": false,
      "allow_legacy_socket_mount": false,
      "strict_workflows": false,
      "timeout_s": 1800
    },
    "self_hosted": {
      "runner_dir": null,
      "systemd_unit": null,
      "systemd_scope": "system",
      "labels": null,
      "timeout_s": 1800,
      "supervise_listener": false,
      "allow_start": false,
      "ephemeral": false,
      "isolated_work_folder": false,
      "log_stale_s": 900
    },
    "jenkins": {
      "url": null,
      "job_path": null,
      "jenkinsfile_path": null,
      "local_runner": null,
      "crumb_required": true,
      "parameters": [],
      "credential_ids": {
        "bitbucket_checkout": null,
        "bitbucket_status": null
      },
      "report_status": false,
      "webhook_relay": false,
      "timeout_s": 1800
    },
    "scm": {
      "kind": "server",
      "bitbucket_url": null,
      "project_key": null,
      "repo_slug": null,
      "workspace": null
    }
  }
}
