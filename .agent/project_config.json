{
  "question_pool": {
    "frequency": "every_3_cycles",
    "N": 3,
    "processors": ["product_owner", "project_manager"],
    "last_processed_cycle": 0
  },
  "meta_optimizer": {
    "enabled": true,
    "frequency": "after_every_done_cycle",
    "min_quality": {
      "confidence": 0.85,
      "tests_failed": 0,
      "process_violations": 0
    },
    "auto_apply_safe": true,
    "max_proposals_per_cycle": 3,
    "last_harvested_cycle": 0
  },
  "daily_decomposition_ritual": {
    "enabled": true,
    "frequency": "every_10_cycles",
    "N": 10,
    "last_ritual_cycle": 0
  },
  "tier": {
    "level": "free",
    "feature_flags": {
      "hub_premium": false,
      "eval_harness": true,
      "enterprise_governance": true
    }
  },
  "integrations": {
    "github_actions": { "enabled": true, "workflow": ".github/workflows/agentix-loop.yml" },
    "issue_tracker": { "provider": "linear", "enabled": false },
    "slack": { "enabled": false }
  },
  "playbooks": {
    "enabled": true,
    "auto_curate": true
  },
  "audit": {
    "enabled": true,
    "path": ".agent/AUDIT_LOG.json"
  }
}