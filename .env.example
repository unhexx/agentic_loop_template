# These names are not loaded from this file. Export them, or point systemd at
# EnvironmentFile=. Do not assume "copy to .env" arms the dashboard.
# DASHBOARD_TOKEN must be at least 16 characters. An empty value does not
# disable the check. AGENTIX_DASHBOARD_ALLOW_OPEN=1 is the explicit local opt-in.

DASHBOARD_TOKEN=
AGENTIX_DASHBOARD_HOST=127.0.0.1
AGENTIX_DASHBOARD_PORT=8112
AGENTIX_DASHBOARD_WORKDIR=
