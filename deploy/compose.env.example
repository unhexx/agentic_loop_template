# Скопируйте в deploy/compose.env (файл в gitignore).
# Если файла нет, `agentix-stack.sh up` копирует этот пример; compose
# передаёт --env-file только когда deploy/compose.env уже есть.
#
# Секрет SearXNG не здесь: server.secret_key в deploy/searxng/settings.yml.

# Живые вызовы модели идут через шлюз Agentix → host pxpipe :8100.
# Шлюз должен слушать 127.0.0.1:8110 на хосте (python -m memory.proxy serve).
LDR_LLM_PROVIDER=openai_endpoint
LDR_LLM_OPENAI_ENDPOINT_URL=http://host.docker.internal:8110/v1
LDR_LLM_OPENAI_ENDPOINT_API_KEY=local
LDR_LLM_MODEL=grok

# Если поднят профиль ollama и хотите локальную модель вместо шлюза:
# LDR_LLM_PROVIDER=ollama
# LDR_LLM_MODEL=gemma3:4b
# LDR_LLM_OLLAMA_URL=http://ollama:11434
