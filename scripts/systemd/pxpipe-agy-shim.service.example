[Unit]
Description=pxpipe-agy context compression proxy for Antigravity CLI (agy)
Documentation=file://%h/.config/pxpipe-agy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Живой вход: scripts/pxpipe-agy/proxy.mjs. Не подменять на shim.py:
# shim.py занимает и :8101, и :8102.
ExecStart=/usr/bin/node %h/.config/pxpipe-agy/proxy.mjs
Restart=on-failure
RestartSec=2
Environment=HOST=127.0.0.1
Environment=PORT=8101
Environment=PXPIPE_LOG=%h/.pxpipe-agy/events.jsonl
WorkingDirectory=%h
NoNewPrivileges=true

[Install]
WantedBy=default.target
