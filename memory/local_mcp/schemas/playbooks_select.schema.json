{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentix://local_mcp/playbooks_select.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "working_directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "query": { "type": "string", "maxLength": 200 },
    "k": { "type": "integer", "minimum": 1, "maximum": 20 },
    "scopes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^(global|role:[A-Za-z0-9_.:*-]+|tool:[A-Za-z0-9_.:*-]+|phase:[A-Za-z0-9_.:*-]+)$"
      }
    }
  }
}
