# Copy to .env.agentic (never commit)
AGENTIC_WORKSPACE_ID=your-org/your-project
AGENTIC_TIER=free
AGENTIC_LOOP_SPEC=TASK_SPECIFICATION.md

# Request proxy (host pxpipe). AGENTIX_PROXY=0 is the explicit opt-out.
AGENTIX_PROXY=1
AGENTIX_PROXY_MODE=required
GROK_CLI_CHAT_PROXY_BASE_URL=http://127.0.0.1:8110/v1
AGENTIX_PXPIPE_URL=http://127.0.0.1:8100
AGENTIX_GATEWAY_URL=http://127.0.0.1:8110

# Operator dashboard (loopback :8112, not the gateway). Empty = local trust.
# Set DASHBOARD_TOKEN before SSH -L / Tailscale Serve — a funnel without a token is a violation.
DASHBOARD_TOKEN=